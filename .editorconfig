root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{c,cpp,h,hpp,h.in}]
indent_style = tab
indent_size = 4
tab_width = 4

[CMakeLists.txt]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
